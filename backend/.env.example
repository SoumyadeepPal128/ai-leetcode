# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# Get this from https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=your_key_here

# Piston is the free, open-source code execution API we use to run
# both the reference solution (during generation) and the user's
# submitted code (during verdict). Public instance below, or self-host
# later with: docker run -p 2000:2000 ghcr.io/engineer-man/piston
PISTON_API_URL=https://emkc.org/api/v2/piston
